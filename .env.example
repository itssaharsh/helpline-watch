# Copy to .env (never commit .env). Every variable is optional.
# Without a key the app runs in replay mode from recorded/synthetic fixtures.
SERPAPI_API_KEY=
# live | replay | auto   (auto = use a fixture when one exists, otherwise call SerpApi)
HELPLINE_MODE=auto
# hard cap on SerpApi calls per sweep (each call = 1 search credit)
HELPLINE_MAX_CALLS=60
